# Musubi backend ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp doldurun:
#   cp .env.example .env
# `.env` gitignore'dadır, asla commit edilmez.

PORT=5000
# Yalnızca production veya development — başka değerle sunucu açılmaz
NODE_ENV=development

# MongoDB bağlantısı (Atlas veya lokal). Sondaki veritabanı adı ZORUNLU:
# adsız bırakılırsa Mongoose "test" adlı DB'ye bağlanır. Düzen: aynı cluster'da
# lokal geliştirme /musubi-dev, production (Railway) /musubi kullanır;
# testler in-memory MongoDB kullandığı için bu ayardan etkilenmez.
# Yeni DB'ye kelimeleri yüklemek için: npm run seed && npm run select-core
MONGO_URI=mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/musubi-dev

# JWT — iki secret birbirinden FARKLI, uzun ve rastgele olmalı
JWT_SECRET=<rastgele-uzun-string>
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=<farkli-rastgele-uzun-string>
JWT_REFRESH_EXPIRE=30d

# Şifre sıfırlama linkinin geçerlilik süresi (ms) — 3600000 = 1 saat
RESET_PASSWORD_EXPIRE=3600000

# E-postalardaki doğrulama/sıfırlama linklerinin taban adresi.
# PRODUCTION'DA ZORUNLU: backend'in public adresi olmalı
# (örn. https://musubi-backend-production.up.railway.app) — tanımsız
# bırakılırsa mail gönderimleri hata verir. Dev/test'te localhost'a düşer.
CLIENT_URL=http://localhost:5000

# E-posta gönderimi (Resend) — EMAIL_FROM domain'i Resend'de doğrulanmış olmalı
RESEND_API_KEY=re_...
EMAIL_FROM=Musubi <noreply@ornek.com>

# Sosyal giriş (POST /auth/social) — idToken'ın aud claim'i bu listeyle eşleşmeli
# Google: iOS/Android/Web client ID'leri virgülle ayrılır
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# Apple: uygulamanın bundle ID'si (Sign in with Apple)
APPLE_CLIENT_IDS=com.ornek.musubi
# Hesap silmede Apple token iptali (App Store 5.1.1(v)). Apple Developer >
# Keys > "Sign in with Apple" anahtarı. Boşsa iptal atlanır (uyarı loglanır).
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=XYZ9876543
# .p8 dosyasının base64'ü: base64 -w0 AuthKey_XYZ9876543.p8
APPLE_PRIVATE_KEY_B64=
# Opsiyonel; yoksa APPLE_CLIENT_IDS'in ilki kullanılır
APPLE_REVOKE_CLIENT_ID=

# Firebase App Check — açık auth uçları gerçek uygulamadan gelen isteği ister.
# İstemci App Check SDK'sını entegre etmeden AÇMAYIN (giriş kırılır). Web
# simülatörü token üretemez; simülatörle test edilen ortamda kapalı tutun.
APP_CHECK_ENFORCE=false

# Zamanlanmış görevler. Servis birden fazla kopyayla çalışırsa ek kopyalarda
# false yapın; aksi halde bildirimler her kopyadan ayrı gider.
CRON_ENABLED=true

# --- Deep link (Universal Links / App Links) ---
# Mail linkleri (/verify-email/:token, /reset-password/:token) uygulama
# KURULUYSA uygulamada, değilse web sayfasında açılır. Aşağıdakiler boşken
# /.well-known/… dosyaları 404 döner ve her link web'e iner — akış kırılmaz.
# Yarım/yanlış dosya yayımlamak 404'ten KÖTÜDÜR: iOS CDN'i ve Android'in
# kurulum doğrulaması bu dosyaları önbelleğe alır.
#
# iOS: "<Apple Team ID>.<bundle ID>", virgülle birden fazla (dev/prod ayrıysa)
IOS_APP_IDS=ABCDE12345.com.ornek.musubi
# Android: paket adı + imza SHA-256 parmak izleri (virgülle).
# Play App Signing ile yayınlanan sürümün imzası geliştirme imzasından
# FARKLIDIR; ikisi de yazılmazsa o taraf doğrulamayı geçemez.
ANDROID_PACKAGE=com.ornek.musubi
ANDROID_CERT_FINGERPRINTS=AB:CD:EF:...:12,34:56:78:...:90

# Günlük havuz fallback limitleri (kullanıcının dailyGoal'u yoksa)
NEW_WORD_DAILY_LIMIT=10
REVIEW_DAILY_LIMIT=10

# Production'da izin verilen origin'ler (virgülle ayrılır)
CORS_ORIGIN=https://app.ornek.com

# --- Mobil simülatör (public/) ---
# Dev'de simülatör kökten koşulsuz servis edilir; bu bayrak CANLI ortam içindir.
# true olduğunda /sim altında açılır — mobil istemci olmadan uygulamayı web'den
# test ettirmek için. Sayfa parolasız: linki alan girer, veriye erişim /api'nin
# kendi auth'undadır. Kapatmak = bu değişkeni silmek (deploy gerekmez).
SIMULATOR_ENABLED=false

# --- Görsel yükleme (POST /api/uploads, yalnızca admin) ---
# Depolama sürücüsü: şu an yalnızca `local`. Yüklenen dosyalar diske yazılır ve
# backend `/uploads` altından servis eder.
STORAGE_DRIVER=local
#
# ⚠️ RAILWAY: konteynerin diski kalıcı DEĞİLDİR. Servise bir Volume bağlanmadan
# bu değişkeni bırakırsanız yüklenen görseller İLK DEPLOY'DA SESSİZCE SİLİNİR.
# Railway panelinde servise Volume ekleyip mount path'i (örn. /data) verin ve:
#   UPLOAD_DIR=/data/uploads
# Lokalde varsayılan yeterli (repo kökünde ./uploads, gitignore'da).
UPLOAD_DIR=./uploads

# Push bildirimleri (Firebase Cloud Messaging) — lokalde
# config/firebase-service-account.json dosyası yeterlidir, bu değişken gerekmez.
# Railway'de (dosya olmadığı için) servis hesabı JSON'unun base64'ü verilir:
#   base64 -w0 config/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoi...
